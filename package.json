{
  "name": "cancer-screening-passport",
  "private": true,
  "version": "0.1.0",
  "description": "A patient-centered cancer screening and survivorship passport for web and mobile packaging.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs",
    "build:static": "vite build",
    "start": "node server-dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server-dist",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "test:rules": "npx -y firebase-tools@13.13.3 emulators:exec --only firestore \"vitest run firestore.rules.test.ts\"",
    "preflight:beta": "node scripts/beta-preflight.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:static": "SMOKE_STATIC_ONLY=true node scripts/smoke.mjs",
    "native:check": "node scripts/native-check.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:cloudflare-pages-env": "node scripts/validate-cloudflare-pages-env.mjs",
    "validate:deploy-env": "node scripts/validate-deploy-env.mjs",
    "validate:rules-deploy-env": "node scripts/validate-rules-deploy-env.mjs",
    "cap:sync": "npm run build:static && cap sync",
    "cap:copy": "npm run build:static && cap copy",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
